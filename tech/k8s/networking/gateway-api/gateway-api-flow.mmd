%%{init: {"flowchart": {"curve": "basis", "htmlLabels": true, "padding": 16}, "themeVariables": {"fontFamily": "Segoe UI, Inter, sans-serif"}}}%%
%% Gateway API - core components, relationships, and request flow
%% Render: https://mermaid.live  or VS Code "Markdown Preview Mermaid" extension

flowchart TB
    client(["Client / Browser"]):::client

    %% ===================== CONTROL PLANE =====================
    subgraph CONTROL["CONTROL PLANE - Declarative config"]
        direction TB

        gc("<b>GatewayClass</b> (cluster)<br/>controllerName<br/>registers the controller"):::infra
        gw("<b>Gateway</b> (ns: gateway-infra)<br/>listeners: http 80 / https 443<br/>tls: Terminate<br/>allowedRoutes.from: All"):::operator
        route("<b>HTTPRoute</b> (ns: app-ns)<br/>hostnames: app.example.com<br/>rules: header / path / weight"):::dev
        rg("<b>ReferenceGrant</b> (ns: app-ns)<br/>allows cross-namespace refs"):::dev

        gc -- "gatewayClassName" --> gw
        gw -- "parentRefs" --> route
        rg -. "permits" .-> route
    end

    %% ===================== CONTROLLER =====================
    controller("<b>Gateway Controller</b><br/>Envoy Gateway / Cilium / Istio<br/>watch CRDs and reconcile"):::ctrl

    %% ===================== DATA PLANE =====================
    subgraph DATA["DATA PLANE - Runtime traffic"]
        direction TB

        proxy("<b>Proxy</b><br/>Envoy / NGINX / eBPF<br/>TLS terminate + L7 routing"):::proxy

        scanary("svc-canary : 8080"):::svc
        sapi("svc-api : 8080"):::svc
        smain("svc-main : 80"):::svc

        proxy -- "header x-env=canary" --> scanary
        proxy -- "path /api" --> sapi
        proxy -- "default catch-all" --> smain
    end

    %% ===================== WIRING =====================
    gc -.-> controller
    gw -.-> controller
    route -.-> controller
    controller == "render config + provision" ==> proxy

    client == "HTTPS app.example.com" ==> proxy

    %% ===================== STYLES =====================
    classDef client   fill:#334155,stroke:#475569,color:#f8fafc,stroke-width:1px,rx:14,ry:14
    classDef infra    fill:#f3effe,stroke:#a78bfa,color:#5b21b6,stroke-width:1px,rx:14,ry:14
    classDef operator fill:#eaf2fe,stroke:#93c5fd,color:#1d4ed8,stroke-width:1px,rx:14,ry:14
    classDef dev      fill:#e6faf0,stroke:#6ee7b7,color:#047857,stroke-width:1px,rx:14,ry:14
    classDef ctrl     fill:#fef6e4,stroke:#fcd34d,color:#b45309,stroke-width:1px,rx:14,ry:14
    classDef proxy    fill:#fdecec,stroke:#fca5a5,color:#b91c1c,stroke-width:1px,rx:14,ry:14
    classDef svc      fill:#eef1f6,stroke:#cbd5e1,color:#334155,stroke-width:1px,rx:12,ry:12

    style CONTROL fill:#f1f0f7,stroke:#dcd9ec,stroke-width:1.5px,color:#6b6586,rx:18,ry:18
    style DATA    fill:#f0f3f5,stroke:#d6dee2,stroke-width:1.5px,color:#5f7380,rx:18,ry:18

    linkStyle default stroke:#cbd5e1,stroke-width:1.5px
